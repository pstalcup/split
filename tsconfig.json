{
  "compilerOptions": {
    "noEmit": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "declaration": false,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2019"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "pretty": true,
    "strict": true,
    "target": "es2018",
    "paths": {
      "loopstar/*": ["./vendor/loopstar/src/*"],
      "garbo/*": ["./vendor/garbage-collector/packages/garbo/src/*"],
      "garbo-lib": ["./vendor/garbage-collector/packages/garbo-lib/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "*.ts"]
}
