[submodule "vendor/loopstar"]
	path = vendor/loopstar
	url = https://github.com/Kasekopf/loopstar.git
[submodule "vendor/garbage-collector"]
	path = vendor/garbage-collector
	url = https://github.com/loathers/garbage-collector.git
	# patches/garbage-collector is applied to the working tree at build time
	ignore = dirty
