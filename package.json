{
  "name": "split",
  "version": "0.1.0",
  "description": "KoLmafia script that splits a casual run across two days, interleaving loopstar questing with garbo farming",
  "private": true,
  "license": "ISC",
  "scripts": {
    "patch-vendor": "node scripts/apply-patches.mjs",
    "prebuild": "node scripts/apply-patches.mjs",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "precheck": "node scripts/apply-patches.mjs",
    "check": "node scripts/check.mjs",
    "lint": "prettier --check src *.mjs *.json *.md"
  },
  "dependencies": {
    "core-js": "^3.16.4",
    "garbo-lib": "^1.0.3",
    "grimoire-kolmafia": "^0.3.35",
    "kolmafia": "^5.29363.0",
    "libram": "^0.11.38",
    "mafia-shared-relay": "^0.0.7",
    "msr": "npm:mafia-shared-relay@^0.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.15.0",
    "@babel/plugin-proposal-class-properties": "^7.14.5",
    "@babel/plugin-proposal-object-rest-spread": "^7.14.7",
    "@babel/preset-env": "^7.15.0",
    "@babel/preset-typescript": "^7.15.0",
    "@types/node": "^20.6.1",
    "esbuild": "^0.24.2",
    "esbuild-plugin-babel": "^0.2.3",
    "prettier": "^2.3.2",
    "typescript": "^5.4.0"
  }
}
