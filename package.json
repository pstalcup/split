{
  "name": "split",
  "version": "0.1.0",
  "description": "KoLmafia script that runs a casual run over two days, scheduling loopstar questing and garbo farming together",
  "homepage": "https://github.com/pstalcup/split",
  "repository": "https://github.com/pstalcup/split",
  "private": true,
  "scripts": {
    "build": "node scripts/apply-patches.mjs && rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "check": "node scripts/apply-patches.mjs && tsc",
    "format": "eslint src --fix --ext .ts && NODE_OPTIONS=\"--experimental-strip-types\" prettier --write .",
    "lint": "eslint src --ext .ts &&  NODE_OPTIONS=\"--experimental-strip-types\" prettier --check .",
    "watch": "node scripts/apply-patches.mjs && rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript --watch",
    "install-mafia": "yarn run build && create-kolmafia-script --install"
  },
  "dependencies": {
    "grimoire-kolmafia": "^0.3.35",
    "kolmafia": "latest",
    "libram": "^0.11.40"
  },
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/babel__core": "^7.20.5",
    "@types/babel__preset-env": "^7.10.0",
    "@types/node": "^25.3.0",
    "create-kolmafia-script": "latest",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-libram": "^0.6.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "rollup": "^4.57.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "packageManager": "yarn@4.18.0"
}
